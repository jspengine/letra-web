{
  "framework": "vite",
  "installCommand": "npm --prefix landing ci",
  "buildCommand": "npm --prefix landing run build",
  "outputDirectory": "landing/dist",
  "rewrites": [
    { "source": "/brand/:path*", "destination": "/brand/index.html" },
    { "source": "/docs/:path*", "destination": "/docs/index.html" },
    { "source": "/blog/:path*", "destination": "/blog/index.html" }
  ]
}
